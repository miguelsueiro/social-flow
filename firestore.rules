rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isRole(role) {
      return isSignedIn() && getUserData().role == role;
    }

    function isAgencyRole() {
      return isRole('creative_director') || isRole('copy') || isRole('art_director') || isRole('designer') || isRole('account_manager') || isRole('community_manager') || isRole('admin');
    }

    function isAdmin() {
      return isRole('admin');
    }

    // Projects an agency member is scoped to. Empty = unrestricted (same default
    // as the app's own hasProjectPermission), matching a full agency account.
    function permittedProjectsOf() {
      return getUserData().get('permittedProjects', []);
    }

    function canAccessProjectAsAgency(projectId) {
      let perms = permittedProjectsOf();
      return isAdmin() || perms.size() == 0 || (projectId in perms);
    }

    // A client can only ever touch their own project(s) — checked against
    // their user doc, never trusted from the request payload.
    function isOwnProjectAsClient(projectId) {
      return getUserData().get('projectId', '') == projectId
        || (projectId in getUserData().get('permittedProjects', []));
    }

    function isValidUser(data) {
      return data.uid is string && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 256
        && data.role in ['pending', 'admin', 'creative_director', 'copy', 'art_director', 'designer', 'account_manager', 'community_manager', 'client']
        && (data.name == null || (data.name is string && data.name.size() <= 256));
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow read: if isSignedIn();

      // Self-registration on first login: only as 'pending', with zero access.
      // Any real role/permissions must come from an admin or from an invite
      // resolved server-side by the app before this write happens.
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && isValidUser(incoming())
        && (
          isAdmin() ||
          (
            incoming().role == 'pending'
            && incoming().get('permittedProjects', []).size() == 0
            && incoming().get('projectId', '') == ''
          )
        );

      // A user may update their own profile, but never their own role or
      // project access — that would be self-escalation. Only an admin can
      // change role/permittedProjects/projectId, for themselves or anyone else.
      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          request.auth.uid == userId
          && isValidUser(incoming())
          && incoming().role == existing().role
          && incoming().get('permittedProjects', []) == existing().get('permittedProjects', [])
          && incoming().get('projectId', '') == existing().get('projectId', '')
        )
      );

      allow delete: if isAdmin();
    }

    // --- Invites Collection (doc id = lowercased invited email) ---
    match /invites/{email} {
      allow create, update, delete: if isAdmin();
      // The invited person needs to read their own invite on first login to
      // resolve their role; nobody else may enumerate invites.
      allow get: if isAdmin() || (isSignedIn() && request.auth.token.email.lower() == email);
      allow list: if isAdmin();
    }

    // --- Projects Collection ---
    function isValidProject(data) {
      return data.name is string && data.name.size() <= 256
        && data.clientName is string && data.clientName.size() <= 256
        && data.color is string && data.color.size() <= 10;
    }

    // Repository items hold real client-sensitive material (brand strategy,
    // brandbook) — unlike the project doc itself (readable by any signed-in
    // user, just a name/color), so read access is scoped the same way posts
    // are: agency members within their permitted projects, clients only
    // their own project(s). Declared at top level with every other
    // validator in this file — a Firestore rules function is only reliably
    // callable from nested matches when it's not itself nested inside
    // another match block.
    function isValidRepositoryItem(data) {
      return data.category in ['strategy', 'guidelines', 'brandbook', 'assets', 'links']
        && data.title is string && data.title.size() > 0 && data.title.size() <= 256
        && data.get('description', '') is string && data.get('description', '').size() <= 4000
        && data.get('url', '') is string && data.get('url', '').size() <= 200000
        && data.get('guidelineType', '') in ['', 'do', 'dont'];
    }

    match /projects/{projectId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isAgencyRole() && isValidProject(incoming());
      allow delete: if isAdmin();

      match /repository/{itemId} {
        allow read: if isSignedIn() && (
          canAccessProjectAsAgency(projectId) || isOwnProjectAsClient(projectId)
        );
        allow create, update: if isSignedIn() && isAgencyRole()
          && canAccessProjectAsAgency(projectId)
          && isValidRepositoryItem(incoming())
          && incoming().createdAt is string;
        allow delete: if isSignedIn() && isAgencyRole() && canAccessProjectAsAgency(projectId);
      }
    }

    // --- Posts Collection ---
    // Every field read below goes through .get() with a default. Direct field
    // access (data.platform, resource.data.projectId) raises an error when the
    // field is absent, and on a `list` that error denies the ENTIRE query — so
    // one legacy document missing `projectId` would make the whole posts
    // collection unreadable for every user, which surfaces in the app as an
    // empty calendar with no explanation. Defaults fail that single document's
    // check instead of the collection's.
    // idea/copyCaption/copyCreativity can now hold sanitized rich-text HTML
    // (bold/italic/underline/links/lists) from the app's RichTextField
    // instead of only plain text — the same words wrapped in tags take more
    // bytes, so these ceilings were raised to give formatting headroom
    // without opening the door to arbitrarily large payloads.
    function isValidPost(data) {
      return data.get('platform', '') in ['instagram', 'linkedin', 'tiktok']
        && data.get('phase', '') in ['idea_1', 'idea_2', 'copy', 'design', 'client_review', 'changes_requested', 'approved', 'published']
        && data.get('idea', '') is string && data.get('idea', '').size() <= 8000
        && data.get('copyCaption', '') is string && data.get('copyCaption', '').size() <= 10000
        && data.get('copyCreativity', '') is string && data.get('copyCreativity', '').size() <= 4000;
    }

    function isClientVisible(phase) {
      return phase in ['copy', 'design', 'client_review', 'changes_requested', 'approved', 'published'];
    }

    function postProjectId(data) {
      return data.get('projectId', '');
    }

    function postPhase(data) {
      return data.get('phase', '');
    }

    match /posts/{postId} {
      allow list: if isSignedIn() && (
        (isAgencyRole() && canAccessProjectAsAgency(postProjectId(resource.data))) ||
        (isRole('client') && isOwnProjectAsClient(postProjectId(resource.data)) && isClientVisible(postPhase(resource.data)))
      );

      allow get: if isSignedIn() && (
        (isAgencyRole() && canAccessProjectAsAgency(postProjectId(existing()))) ||
        (isRole('client') && isOwnProjectAsClient(postProjectId(existing())) && isClientVisible(postPhase(existing())))
      );

      // A post must always name a real project. Creating one without a
      // projectId produces a document no view can ever show it in.
      allow create: if isAgencyRole()
        && postProjectId(incoming()) != ''
        && canAccessProjectAsAgency(postProjectId(incoming()))
        && isValidPost(incoming())
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn() && (
        (isAgencyRole() && canAccessProjectAsAgency(postProjectId(existing())) && isValidPost(incoming()) && incoming().updatedAt == request.time) ||
        (isRole('client') && isOwnProjectAsClient(postProjectId(existing())) && isClientVisible(postPhase(existing())) && (
          // Clients can only approve or request changes on their own post —
          // never edit content, and never reach any other phase directly.
          incoming().diff(existing()).affectedKeys().hasOnly([
            'phase', 'updatedAt',
            'approvedBy', 'approvedAt',
            'changesRequestedReason', 'changesRequestedAt', 'changesRequestedBy'
          ])
          && postPhase(incoming()) in ['client_review', 'changes_requested', 'approved']
          && incoming().updatedAt == request.time
        ))
      );

      allow delete: if isAgencyRole() && canAccessProjectAsAgency(postProjectId(existing()));

      // --- Comments Subcollection (internal agency discussion — never client-facing) ---
      match /comments/{commentId} {
        allow read, list: if isSignedIn() && isAgencyRole();

        allow create: if isSignedIn() && isAgencyRole()
          && incoming().get('authorId', '') == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().get('text', '') is string
          && incoming().get('text', '').size() <= 1000;

        allow update, delete: if isRole('admin') || (isSignedIn() && existing().get('authorId', '') == request.auth.uid);
      }

      // --- Feedbacks Subcollection ---
      match /feedbacks/{feedbackId} {
        allow read, list: if isSignedIn();

        allow create: if isSignedIn() && (
          isAgencyRole() ||
          (isRole('client') && isClientVisible(postPhase(get(/databases/$(database)/documents/posts/$(postId)).data)))
        ) && incoming().get('authorId', '') == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().get('text', '') is string
          && incoming().get('text', '').size() <= 2000;

        // Editing the text is author-only. Agency can flip done/doneAt/doneBy
        // without touching the text or reassigning authorship.
        allow update: if isSignedIn() && (
          (existing().get('authorId', '') == request.auth.uid && incoming().get('authorId', '') == existing().get('authorId', ''))
          || (isAgencyRole() && incoming().diff(existing()).affectedKeys().hasOnly(['done', 'doneAt', 'doneBy']))
          || isAdmin()
        );

        allow delete: if isRole('admin') || (isSignedIn() && existing().get('authorId', '') == request.auth.uid);
      }
    }

    // --- Notifications Collection ---
    match /notifications/{notifId} {
      // Admins see everything; everyone else only notifications tied to a
      // project they can access (or legacy docs with no projectId at all).
      allow read: if isSignedIn() && (
        isAdmin() ||
        !('projectId' in resource.data) ||
        resource.data.projectId == '' ||
        (isAgencyRole() && canAccessProjectAsAgency(resource.data.projectId)) ||
        (isRole('client') && isOwnProjectAsClient(resource.data.projectId))
      );
      allow create: if isSignedIn() && incoming().createdAt is timestamp;
      allow update, delete: if isAdmin();
    }

    // --- Workspace Settings ---
    // Single document (settings/agency) holding agency-wide preferences
    // (name, timezone, notification toggles, theme color).
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAgencyRole();
    }
  }
}
